# ---------------------------------------------------------------------------
# Data: must NEVER be committed. It is too large for GitHub, and Kaggle's
# competition rules restrict redistributing it.
# ---------------------------------------------------------------------------
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.parquet
*.csv
*.zip

# Kaggle API credentials
kaggle.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

